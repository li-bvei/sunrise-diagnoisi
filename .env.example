VITE_APP_NAME=SUNRISE 专业诊断中心
VITE_DEFAULT_LOCALE=zh-CN
VITE_API_BASE_URL=/api
VITE_SUNRISE_OFFICIAL_URL=
VITE_CONTACT_PHONE=06-7650-6385
VITE_CONTACT_ADDRESS=大阪市天王寺区勝山４丁目７－３佐々木ビル２階

# ---- 宅建题库 API（server/，数据存在宝塔 MySQL）----
# 部署到服务器时写在服务器项目根目录新建的 .env 里（不是改这个 .env.example！
# .env.example 被 git 跟踪，每次部署都会被还原成空模板；.env 被 git 忽略，部署不会动它）。
# 数据库和用户在宝塔「数据库」里创建；权限选「本地服务器」即可（容器通过 unix socket 连接）。
TAKKEN_DB_NAME=
TAKKEN_DB_USER=
TAKKEN_DB_PASSWORD=
# 新增/修改题目所需的令牌（自己生成一串长随机字符，例如 openssl rand -hex 24）；留空则接口只读。
TAKKEN_ADMIN_TOKEN=
# 宿主机 MySQL 的 socket 路径，宝塔默认是 /tmp/mysql.sock；不同请改这里。
# TAKKEN_DB_SOCKET=/tmp/mysql.sock
