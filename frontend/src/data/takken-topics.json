[
  {
    "id": "t1",
    "tag": "民法",
    "title": "赁贷借契约 vs 使用贷借契约",
    "source": "平成27年 問3",
    "sections": [
      {
        "heading": "核心逻辑",
        "blocks": [
          { "type": "text", "text": "赁贷借（有偿）→ 参照买卖规则；使用贷借（无偿）→ 参照赠与规则。" }
        ]
      },
      {
        "heading": "对比速查",
        "blocks": [
          {
            "type": "table",
            "headers": ["比较项", "赁贷借（有偿）", "使用贷借（无偿）"],
            "rows": [
              ["借主死亡", "不终止，继承人继承", "终止（基于情谊）"],
              ["必要费用", "贷主负担", "借主自己负担"],
              ["契约性质", "诺成契约", "诺成契约（新法已改）"],
              ["不适合担保责任", "要负责", "原则不负，明知瑕疵不告知除外"]
            ]
          }
        ]
      },
      {
        "heading": "易错陷阱",
        "blocks": [
          { "type": "trap", "text": "\"使用贷借完全不负担保责任\"是错的绝对化表述——正确是\"原则不负，但贷主明知瑕疵不告知的除外\"。" }
        ]
      }
    ]
  },
  {
    "id": "t2",
    "tag": "民法",
    "title": "法定相续（继承）",
    "source": "平成26年 問10",
    "sections": [
      {
        "heading": "继承顺位",
        "blocks": [
          { "type": "text", "text": "第一顺位子女 → 第二顺位父母 → 第三顺位兄弟姐妹（配偶永远是当然继承人，与顺位并行）" }
        ]
      },
      {
        "heading": "核心规则",
        "blocks": [
          {
            "type": "list",
            "style": "unordered",
            "items": [
              "内缘の妻（事实婚配偶）没有法定继承权——只有正式登记的配偶才算",
              "半血兄弟姐妹份额 = 全血兄弟姐妹份额的一半（民法900条4号但书）",
              "代袭继承是\"整份继承\"：先死之人的份额整体转给其子女，子女之间再平分"
            ]
          }
        ]
      },
      {
        "heading": "计算步骤模板",
        "blocks": [
          {
            "type": "list",
            "style": "ordered",
            "items": [
              "先排除没有继承资格的人（如内缘配偶）",
              "按\"全血=2份、半血=1份\"分配基础份额",
              "已故继承人的份额，由其子女代袭继承（整份转移、多子女平分）",
              "验算：所有份额相加应等于1"
            ]
          }
        ]
      },
      {
        "heading": "易错陷阱",
        "blocks": [
          { "type": "trap", "text": "事实婚配偶容易被误当有继承权；代袭继承容易算错分配对象——是\"整份转给已故人的子女\"，不是打散重分给全体继承人。" }
        ]
      }
    ]
  },
  {
    "id": "t3",
    "tag": "借地借家法",
    "title": "四种\"确保到期终止\"的借地权",
    "source": "令和3年10月 問11",
    "sections": [
      {
        "heading": "速查表",
        "blocks": [
          {
            "type": "table",
            "headers": ["类型", "期限", "形式", "用途"],
            "rows": [
              ["一般定期借地权", "50年以上", "书面即可", "不限"],
              ["事业用定期借地权", "10-50年", "必须公正证书", "只能事业用"],
              ["建物讓渡特约付", "30年以上", "不需书面", "不限"],
              ["一时使用目的", "无要求", "无要求", "临时使用"]
            ]
          }
        ]
      },
      {
        "heading": "判断步骤",
        "blocks": [
          {
            "type": "list",
            "style": "ordered",
            "items": [
              "用途是什么？（居住用直接排除事业用定期借地权）",
              "约定的期限是多少？（决定该用哪种类型）"
            ]
          },
          {
            "type": "mnemonic",
            "text": "一般定期：\"50年起步，不限用途，书面就行\"\n事业用定期：\"10-50年，只能事业用，必须公正证书\"\n建物讓渡特约：\"30年起步，不限用途，不需要书面\"\n一时使用目的：\"没有期限下限，专门给临时使用场景用\""
          }
        ]
      },
      {
        "heading": "易错陷阱",
        "blocks": [
          { "type": "trap", "text": "看到\"事业用建筑物\"别急着套用事业用定期借地权——期限才是决定性因素，超过50年就得换一般定期借地权。" }
        ]
      }
    ]
  },
  {
    "id": "t4",
    "tag": "借地借家法",
    "title": "裁判所代诺许可制度",
    "source": "平成23年 問11",
    "sections": [
      {
        "heading": "四种场景 & 申请人",
        "blocks": [
          {
            "type": "table",
            "headers": ["场景", "申请人"],
            "rows": [
              ["借地条件变更（协商不成）", "双方都可以"],
              ["重建超期建筑物（地主不同意）", "借地权人"],
              ["打算转让给第三者（还没发生）", "借地权人本人"],
              ["第三者已拍卖取得（已经发生）", "第三者"]
            ]
          },
          {
            "type": "mnemonic",
            "text": "\"事还没办成，找原来的人（借地权人）；事已经办成了，找现在的人（第三者）\"——关键看转让/取得是否已经实际发生。"
          }
        ]
      }
    ]
  },
  {
    "id": "t5",
    "tag": "民法",
    "title": "请负契约（承揽合同）",
    "source": "令和元年 問8",
    "sections": [
      {
        "heading": "核心规则速查",
        "blocks": [
          {
            "type": "table",
            "headers": ["场景", "规则"],
            "rows": [
              ["建筑物严重不符合合同需重建", "可要求\"重建费用\"赔偿（最判平14.9.24）"],
              ["请负人担保责任存续期限", "普通消灭时效（知道起5年/能行使起10年），不能靠特约延长"],
              ["因注文者原因导致履行不能", "请负人可行使解除权免除未履行义务"],
              ["请负人未完成工作", "注文者随时可赔偿损失、任意解除（641条）"]
            ]
          }
        ]
      },
      {
        "heading": "易错陷阱",
        "blocks": [
          { "type": "trap", "text": "担保责任存续期限是法定消灭时效，不能通过合同约定延长（如20年）——涉及交易秩序稳定性的强制性规定不容突破。" }
        ]
      }
    ]
  }
]
